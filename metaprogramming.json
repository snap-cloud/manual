e","url":"/build/image971-d50e10b2f5c782958ff7a99f1cb6c115.png","alt":"image971.png","width":"3.11in","align":"center","key":"Ugv45Tl00S","urlSource":"images/11-metaprogramming/image971.png"}],"key":"AZiOiLvybn"},{"type":"paragraph","position":{"start":{"line":181,"column":1},"end":{"line":186,"column":1}},"children":[{"type":"text","value":"Returning to the define block, there’s another reason for the block\nupvar: It’s helpful in defining a recursive procedure using define\n. For a procedure to call\nitself, it needs a name for itself. But in the definition input to the\ndefine block, define itself hasn’t been called yet, so the new block\nisn’t in the palette yet. So you do this:","position":{"start":{"line":181,"column":1},"end":{"line":181,"column":1}},"key":"ZD5Sa8QYIO"}],"key":"Snt5P3UGmT"},{"type":"paragraph","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"children":[{"type":"image","url":"/build/image972-217a07d9549a63670d0808211e0bde5c.png","alt":"image972.png","width":"3.57in","align":"center","key":"T2m7UyMbUs","urlSource":"images/11-metaprogramming/image972.png"}],"key":"JUEhmW1iZ7"},{"type":"paragraph","position":{"start":{"line":190,"column":1},"end":{"line":191,"column":1}},"children":[{"type":"text","value":"Yes, you put block in the define, but it gets changed into this script\nin the resulting definition.","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"WWOxsUYHE6"}],"key":"hyoxzasrgh"},{"type":"paragraph","position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"children":[{"type":"image","url":"/build/image973-f506e78998f8fb26b4094f6ae03be98e.png","alt":"image973.png","width":"3.60in","align":"center","key":"AUZZPrX5GT","urlSource":"images/11-metaprogramming/image973.png"}],"key":"uKEB9zDDtB"},{"type":"paragraph","position":{"start":{"line":195,"column":1},"end":{"line":195,"column":1}},"children":[{"type":"image","url":"/build/image974-15ca663f7b320c5faba16e9eefbcddc4.png","alt":"image974.png","width":"1.77in","align":"center","key":"VZQgyXeOy0","urlSource":"images/11-metaprogramming/image974.png"}],"key":"L99fuOH0He"},{"type":"paragraph","position":{"start":{"line":197,"column":1},"end":{"line":197,"column":1}},"children":[{"type":"image","url":"/build/image975-07bff92b75fc3f2d5ea54a39f1fce018.png","alt":"image975.png","position":{"start":{"line":197,"column":1},"end":{"line":197,"column":1}},"key":"TqDpcL4kkx","urlSource":"images/11-metaprogramming/image975.png"},{"type":"text","value":" ","position":{"start":{"line":197,"column":1},"end":{"line":197,"column":1}},"key":"f29mDG6UUD"},{"type":"comment","value":"  style=\"width:3.11in;height:0.57in\" alt=\"Graphical user interface Description automatically generated\" / ","key":"f0nQWhjAwz"}],"key":"fkRU2Nw6hr"},{"type":"paragraph","position":{"start":{"line":199,"column":1},"end":{"line":204,"column":1}},"children":[{"type":"text","value":"You could use this script directly in a\nsimple case like this, but in a complicated case with a recursive call\ninside a ring inside the one giving the block definition, this script\nalways means the innermost ring. But the upvar means the outer ring;\nnote how the definition of blockify automatically creates a script\nvariable to hold the outer environment.","position":{"start":{"line":199,"column":1},"end":{"line":199,"column":1}},"key":"wJPjGz1twO"}],"key":"pMo6WuofSa"},{"type":"paragraph","position":{"start":{"line":206,"column":1},"end":{"line":207,"column":1}},"children":[{"type":"text","value":"It’s analogous to using explicit formal parameters when you nest calls\nto higher order functions.","position":{"start":{"line":206,"column":1},"end":{"line":206,"column":1}},"key":"pWsLh39lwt"}],"key":"Kf7QFjkidJ"},{"type":"paragraph","position":{"start":{"line":209,"column":1},"end":{"line":216,"column":1}},"children":[{"type":"text","value":"Note: Ordinarily, when you call a function that reports a (ringed) procedure,\nthat procedure was\ncreated in some specific environment, and has access to that\nenvironment’s variables. This is how instance variables (fields) work in\nobject oriented programming (Chapter VIII). But the procedures made by\njoin of a syntax tree have no associated environment, not even the one\ncontaining global variables. That doesn’t matter if the procedure will\nuse only its own input variables, but for access to other variables, use","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"key":"tXL1AtDxqo"}],"key":"bO4Mh1M7gY"},{"type":"heading","depth":2,"position":{"start":{"line":222,"column":1},"end":{"line":222,"column":1}},"children":[{"type":"text","value":"Macros","position":{"start":{"line":222,"column":1},"end":{"line":222,"column":1}},"key":"S6LfuiaSv5"}],"indexEntries":[{"entry":"macros","emphasis":false},{"entry":"of block (sensing)","emphasis":false}],"identifier":"macros","label":"Macros","html_id":"macros","implicit":true,"key":"Iu7hla1UBc"},{"type":"paragraph","position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"children":[{"type":"image","url":"/build/image976-d32cc8ddda763ad62b5f517feb088b55.png","alt":"image976.png","position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"key":"D06eyYuIr6","urlSource":"images/11-metaprogramming/image976.png"},{"type":"text","value":" ","position":{"start":{"line":224,"column":1},"end":{"line":224,"column":1}},"key":"Y8auMjazP3"},{"type":"comment","value":"  style=\"width:3.11in;height:0.57in\" alt=\"Graphical user interface Description automatically generated\" / ","key":"WCRoa8xMho"}],"key":"qizVDmFKGD"},{"type":"paragraph","position":{"start":{"line":226,"column":1},"end":{"line":228,"column":1}},"children":[{"type":"text","value":"Users of languages in the C family have learned to think of macros as\nentirely about text strings, with no relation to the syntax of the\nlanguage. So you can do things like","position":{"start":{"line":226,"column":1},"end":{"line":226,"column":1}},"key":"R1S9hWpgIH"}],"key":"ITBWzZOucX"},{"type":"paragraph","position":{"start":{"line":230,"column":1},"end":{"line":230,"column":1}},"children":[{"type":"text","value":"#define foo baz)","position":{"start":{"line":230,"column":1},"end":{"line":230,"column":1}},"key":"Hdfr0V3AZX"}],"key":"pmoyvTu6Sd"},{"type":"paragraph","position":{"start":{"line":232,"column":1},"end":{"line":233,"column":1}},"children":[{"type":"text","value":"with the result that you can only use the foo macro after an open\nparenthesis.","position":{"start":{"line":232,"column":1},"end":{"line":232,"column":1}},"key":"ZxB8mjEDvY"}],"key":"bxFjwg9xtN"},{"type":"paragraph","position":{"start":{"line":235,"column":1},"end":{"line":243,"column":1}},"children":[{"type":"text","value":"In the Lisp family of languages we have a different tradition, in which\nmacros are syntactically just like procedure calls,\nexcept that the “procedure” is a macro, with different evaluation rules\nfrom ordinary procedures. Two things make a macro different: its input\nexpressions are not evaluated, so a macro can establish its own syntax\n(but still delimited by parentheses, in Lisp, or still one block, in\nSnap","position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},"key":"NqquHvhZao"},{"type":"emphasis","children":[{"type":"text","value":"!","key":"gZ7tm0wjA2"}],"key":"PwgRdNCqXW"},{"type":"text","value":" ); and the result of a macro call is a new expression that is\nevaluated ","position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},"key":"sT0v1buBAc"},{"type":"emphasis","position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},"children":[{"type":"text","value":"as if it appeared in the caller","position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},"key":"lVqmkbLTsS"}],"key":"zFmPr7hya5"},{"type":"text","value":" of the macro, with access to\nthe caller’s variables and, implicitly, its continuation.","position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},"key":"qDjr7y1R4V"}],"key":"HG60Lwku9m"},{"type":"paragraph","position":{"start":{"line":245,"column":1},"end":{"line":254,"column":1}},"children":[{"type":"text","value":"Snap","position":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}},"key":"GwrA94ZKtU"},{"type":"emphasis","children":[{"type":"text","value":"!","key":"wH5oeAly8K"}],"key":"IbhKK6z2zs"},{"type":"text","value":" has long had the first part of this, the ability to make inputs\nunevaluated. In version 8.0 we add the ability to run code in the\ncontext of another procedure, just as we can run code in the context of\nanother sprite, using the same mechanism: the of block. In the example on the previous page, the if _ report _\ncaller _ block runs a report block, but not in its own context; it\ncauses ","position":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}},"key":"hwyWUaRlGw"},{"type":"emphasis","position":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}},"children":[{"type":"text","value":"the fizzbuzz block","position":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}},"key":"OVkQxLJItM"}],"key":"yD6PzOrpLl"},{"type":"text","value":" to report “fizz” or “buzz” as appropriate.\n(Yes, we know that the rules implemented here are simplified compared to\nthe real game.) It doesn’t just report out of the entire toplevel\nscript; you can see that map is able to prepend “The answer is” to each\nreported value.","position":{"start":{"line":245,"column":1},"end":{"line":245,"column":1}},"key":"ouPXtD8o9M"}],"key":"Wen5E7IFoD"},{"type":"paragraph","position":{"start":{"line":256,"column":1},"end":{"line":256,"column":1}},"children":[{"type":"image","url":"/build/image992-7550575df7f3128f2267f08874025040.png","alt":"image992.png","width":"3.04in","align":"center","key":"e4wqTaD75Y","urlSource":"images/11-metaprogramming/image992.png"}],"key":"PoBwtwoE9w"},{"type":"paragraph","position":{"start":{"line":258,"column":1},"end":{"line":266,"column":1}},"children":[{"type":"text","value":"This macro capability isn’t fully implemented. First, we shouldn’t have\nto use the calling script as an explicit input to the macro. In a later\nrelease, this will be fixed; when defining a block you’ll be able to say\nthat it’s a macro, and it will automatically get its caller’s context as\nan invisible input. Second, there is a possibility of confusion between\nthe variables of the macro and the variables of its caller. (What if the\nmacro wanted to refer to a variable value in its caller?) The one\nsubstantial feature of Scheme that we don’t yet implement is ","position":{"start":{"line":258,"column":1},"end":{"line":258,"column":1}},"key":"iPVru84t4i"},{"type":"emphasis","position":{"start":{"line":258,"column":1},"end":{"line":258,"column":1}},"children":[{"type":"text","value":"hygienic\nmacros,","position":{"start":{"line":258,"column":1},"end":{"line":258,"column":1}},"key":"gdDFBlJhcc"}],"key":"IJqbFz4ibA"},{"type":"text","value":" which make it possible to keep the two namespaces separate.","position":{"start":{"line":258,"column":1},"end":{"line":258,"column":1}},"key":"sG5KZ5IMYK"}],"key":"RCatuLpQU1"}],"key":"opZiHO4yt3"}],"key":"URGPjf1VuM"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"10. Continuations","url":"/continuations","group":"Snap! Reference Manual"},"next":{"title":"12. User Interface Elements","url":"/user-interface-elements","group":"Snap! Reference Manual"}}},"domain":"http://localhost:3000"}